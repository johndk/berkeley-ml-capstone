strict digraph departure_data_flow {
    graph [
        rankdir=TB,
        bgcolor="white",
        pad=0.30,
        nodesep=0.35,
        ranksep=0.55,
        fontname="Helvetica Neue",
        fontcolor="#172033",
        label="Departure-delay data flow — Model 1A",
        labelloc=t,
        fontsize=20
    ];

    node [
        shape=box,
        style="rounded,filled",
        fillcolor="#F6F8FB",
        color="#B8C2D1",
        penwidth=1.2,
        fontname="Helvetica Neue",
        fontcolor="#172033",
        fontsize=11,
        margin="0.16,0.10"
    ];

    edge [
        color="#64748B",
        penwidth=1.3,
        arrowsize=0.75
    ];

    subgraph cluster_sources {
        label="1. Prepare JFK source data";
        labelloc=t;
        style="rounded,filled";
        fillcolor="#FAFBFC";
        color="#D7DEE8";
        penwidth=1.2;
        fontname="Helvetica Neue";
        fontcolor="#475569";
        fontsize=12;
        margin=18;

        { rank=same; bts; aspm; noaa; }

        bts [label="BTS flights\nprocess_bts → clean_bts"];
        aspm [label="ASPM planned demand\nprocess_aspm → clean_aspm"];
        noaa [label="NOAA weather\nprocess_noaa → clean_noaa"];
    }

    merge [
        label="2. Assemble departure rows\nmerge_departures.ipynb  ·  Origin = JFK",
        fillcolor="#EAF2FB",
        color="#5B82AE"
    ];

    merged [
        label="Merged departures\nJFK_YEAR_departures.csv",
        shape=cylinder,
        style=filled,
        fillcolor="#FFF7E3",
        color="#C49120"
    ];

    feature [
        label="3. Engineer pre-pushback features\nfeature_departures.ipynb",
        fillcolor="#F1ECFA",
        color="#8064A8"
    ];

    ready [
        label="Departure feature dataset\nJFK_YEAR_departures.csv",
        shape=cylinder,
        style=filled,
        fillcolor="#FFF7E3",
        color="#C49120"
    ];

    model [
        label="4. Model 1A\npredict DepDel15 before pushback",
        fillcolor="#EAF7EF",
        color="#4B8F63",
        penwidth=1.5
    ];

    bts -> merge;
    aspm -> merge;
    noaa -> merge;
    merge -> merged -> feature -> ready -> model;
}
